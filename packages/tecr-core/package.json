{
  "name": "@tecr/core",
  "version": "0.1.0",
  "description": "TECR core retrieval engine — portable library, no I/O dependencies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danebalia/tecr"
  },
  "keywords": ["mcp", "code-retrieval", "ast", "context-window", "ai", "tecr"],
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "prepare": "tsc"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0",
    "tree-sitter-wasms": "^0.1.13",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "^0.22.6"
  }
}
